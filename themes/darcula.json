  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#6A8759"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#6897BB"
      }
    },
    {
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#FFC66D"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#9876AA"
      }
    },
    {
      "scope": [
        "storage.type.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#BBB529"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#CC7832",
    "string": "#6A8759",
    "number": "#6897BB",
    "comment": "#808080",
    "property": "#9876AA",
    "function.declaration": "#FFC66D",
    "method.declaration": "#FFC66D"
  }
}
